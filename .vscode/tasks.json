{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dotnet: build Debug",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "ArmaExtension.csproj",
                "--configuration",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet: restore",
            "type": "process",
            "command": "dotnet",
            "args": [
                "restore",
                "tests/EdenOnline.SmokeTests/EdenOnline.SmokeTests.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet: build Release",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "ArmaExtension.csproj",
                "--configuration",
                "Release"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet: smoke tests",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "tests/EdenOnline.SmokeTests/EdenOnline.SmokeTests.csproj",
                "--configuration",
                "Debug"
            ],
            "group": {
                "kind": "test"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet: clean Debug",
            "type": "process",
            "command": "dotnet",
            "args": [
                "clean",
                "ArmaExtension.csproj",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet: publish Windows NativeAOT",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "ArmaExtension.csproj"
            ],
            "windows": {
                "command": "dotnet"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Test Extension",
            "type": "shell",
            "command": "powershell",
            "args": [
                "${workspaceFolder}\\Tools\\TestExtension.ps1"
            ],
            "group": {
                "kind": "test"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Test With Arma",
            "type": "shell",
            "command": "powershell",
            "args": [
                "${workspaceFolder}\\Tools\\TestWithArma.ps1"
            ],
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Build Extension",
            "type": "shell",
            "command": "powershell",
            "args": [
                "${workspaceFolder}\\Tools\\BuildExtension.ps1"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Prepare Test Extension",
            "type": "shell",
            "command": "powershell",
            "args": [
                "${workspaceFolder}\\Tools\\PrepareTestExtension.ps1"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
