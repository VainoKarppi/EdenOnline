params ["_entity"];

if !(missionNamespace getVariable ["EOEX_var_Connected",false]) exitWith {};

sleep 0.1; // Give time for the ID to be set, if the object was created by a network message.

// Markers are referenced by name, so the entity is gone if it was renamed or deleted while waiting.
if (_entity isEqualType "" && {!(_entity in (all3DENEntities # 5))}) exitWith {};

// TODO Layer ID might not match with other clients. Create custom identifier.

private _type = [_entity, typeName _entity] call EOEX_fnc_getObjectType; // For some reason we need to send the typename as well, because if we check the typename in the function, it returns OBJECT for WAYPOINTS instead of ARRAY

if (_type == "Group") exitWith {}; // Groups get autogenerated for now.

// Check for an existing ID and register a new one without yielding in between: Eden can report the
// same entity twice (e.g. a vehicle whose crew is added), and a sleep here would let both handlers
// pass the check before either ID exists, sending the object twice.
private _existingId = [_entity, true] call EOEX_fnc_getId;
if (!isNil "_existingId") exitWith {};

private _id = [_entity, false] call EOEX_fnc_getId; // Generate id, if not exist

if (_type != "Layer") then { sleep 0.005 }; // TODO THIS IS A TEMPORARY FIX TO SEND THE LAYER CREATION FIRST WHEN CREATING COMPOSITION

private _layerId = [get3DENLayer _entity, true] call EOEX_fnc_getId;
if (isNil "_layerId") then {_layerId = ""};


if (_type == "Object" || _type == "Trigger" || _type == "Logic") exitWith {
    [_id, _entity, _type, _layerId] call EOEX_fnc_sendCreateObject;
};

// TODO Group
if (_type == "Group") exitWith {
    // TODO similiar to SyncConnection, but for groups
    diag_log _entity;
};

if (_type == "Marker") exitWith {
    [_id, _entity, _layerId] call EOEX_fnc_sendCreateMarker
};

if (_type == "Waypoint") exitWith {
    [_id, _entity, _layerId] call EOEX_fnc_sendCreateWaypoint;
};

if (_type == "Layer") exitWith {
    [_id, _entity, _layerId] call EOEX_fnc_sendCreateLayer;
};

if (_type == "Comment") exitWith {
    [_id, _entity, _layerId] call EOEX_fnc_sendCreateComment;
};