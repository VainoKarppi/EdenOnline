params ["_entity"];

if !(missionNamespace getVariable ["EOEX_var_Connected",false]) exitWith {};

if (_entity isEqualType grpNull) exitWith {}; // Groups get autogenerated for now.

// Give time for the ID to be set, if the object was created by a network message.
// Also this is used to detect if unit/vehicle was pasted.
sleep 0.02; 

// Markers are referenced by name, so the entity is gone if it was renamed or deleted while waiting.
// TODO Slows down too much when we do: all3DENEntities
if (_entity isEqualType "" && {!(_entity in (all3DENEntities # 5))}) exitWith {};

// For some reason we need to send the typename as well, because if we check the typename in the function, it returns OBJECT for WAYPOINTS instead of ARRAY
private _type = [_entity, typeName _entity] call EOEX_fnc_getObjectType;
if (isNil "_type") exitWith { diag_log ["ERROR: Unable to get object type for object: %1 (%2)", _entity, typeOf _entity] };

// Check if we need to send all attributes. (Object was copy pasted)
private _index = EOEX_var_PastedObjects find _entity;
private _isCopy = if (_index != -1) then {
    EOEX_var_PastedObjects deleteAt _index;
    true
} else { false };


// Check for an existing ID and register a new one without yielding in between: Eden can report the
// same entity twice (e.g. a vehicle whose crew is added), and a sleep here would let both handlers
// pass the check before either ID exists, sending the object twice.
private _existingId = [_entity, true] call EOEX_fnc_getId;
if (!isNil "_existingId") exitWith {};

private _id = [_entity, false] call EOEX_fnc_getId; // Generate id, if not exist

if (_type != "Layer") then { sleep 0.005 }; // TODO THIS IS A TEMPORARY FIX TO SEND THE LAYER CREATION FIRST WHEN CREATING COMPOSITION

private _layerId = [get3DENLayer _entity, true] call EOEX_fnc_getId;
if (isNil "_layerId") then {_layerId = ""};


if (_type == "Object" || _type == "Trigger" || _type == "Logic") exitWith {
    [_id, _entity, _type, _layerId, _isCopy] call EOEX_fnc_sendCreateObject;
};

if (_type == "Marker") exitWith {
    [_id, _entity, _layerId, _isCopy] call EOEX_fnc_sendCreateMarker
};

if (_type == "Waypoint") exitWith {
    [_id, _entity, _layerId, _isCopy] call EOEX_fnc_sendCreateWaypoint;
};

if (_type == "Layer") exitWith {
    [_id, _entity, _layerId, _isCopy] call EOEX_fnc_sendCreateLayer;
};

if (_type == "Comment") exitWith {
    [_id, _entity, _layerId, _isCopy] call EOEX_fnc_sendCreateComment;
};